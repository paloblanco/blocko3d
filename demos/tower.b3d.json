{"version":1,"name":"tower","code":"// TOWER: climb the ledges spiralling up a round tower to the flag at the top, Nebulus style.\n// The tower is a flat wall map, 48 blocks around. cam_set_curve(k, 'x', '+z') pushes it away from\n// the camera more and more with distance to the side, so the wall wraps around like a tower. Only\n// the picture bends: you walk and collide on the flat wall. repeat(48, -1, -1) draws everything\n// again 48 blocks to each side, and game code wraps the hero and collides across the edge (see\n// WRAPPING), so you can go all the way around. X shows the other curves.\n// (cam_set_curve(k, 'side', 'away') bends around the camera's sideways direction instead of x, for\n// a camera that circles the tower; this one always looks along +z, so 'x', '+z' is the same.)\n// Controls: left/right walk around the tower, O (Z or space) jumps, X changes the view.\n\nconst W = 48, H = 44                      // around, and up\nconst VIEWS = [\n  // name, curve k, along, push\n  ['tower', 0.1, 'x', '+z'],\n  ['inside a drum', -0.04, 'x', '+z'],\n  ['dome', 0.04, 'xy', '+z'],\n  ['flat (curve off)', 0, 'x', '+z'],\n]\nlet view = 0\nlet px = 2.5, py = 2, pz = 1, vy = 0, grounded = false, facing = 0.25, walk = 0\nlet gems = [], got = 0, ticks = 0, won = false, best = null\nlet topY = 0, flagX = 0\n\n// ---- WRAPPING (all of it): repeat() draws the copies; the hero's position wraps, collision and\n// pickups look across the edge\n// mpush on map 0 as if it repeated every W in x: also push out from the copy across the edge\nfunction wrap_push(x, y, z, r) {\n  let res = mpush(0, x, y, z, r)\n  let ox = x < 1 ? W : x > W - 1 ? -W : 0\n  if (ox) {\n    let q = mpush(0, res[0] + ox, res[1], res[2], r)\n    res = [q[0] - ox, q[1], q[2], q[3] || res[3], q[4] || res[4], q[5] || res[5], max(q[6], res[6])]\n  }\n  return res\n}\n// the distance between two x positions the short way round\nfunction wd(a, b) { let d = abs(a - b) % W; return min(d, W - d) }\n// ----\n\n// a ledge of n blocks at height y starting at x, wrapping around the tower\nfunction ledge(x, y, n, t) { for (let i = 0; i < n; i++) map_box(0, (x + i) % W, y, 0, (x + i) % W, y, 1, t) }\n\nfunction _init() {\n  // map 0: the wall at z 2-3 (bricks, with windows), ledges stick out toward the camera at z 0-1\n  map_new(W, H, 4)\n  map_box(0, 0, 0, 2, W - 1, H - 1, 3, 4)\n  for (let y = 4; y < H - 2; y += 6) for (let x = 3; x < W; x += 8) map_box(0, x, y, 2, x + 1, y + 2, 2, 9)\n  map_box(0, 0, 0, 0, W - 1, 0, 1, 1)       // grass all the way around at the bottom\n  // the climb: ledges spiralling up, each a block or two higher than the last\n  srand(5)\n  let x = 6, y = 1\n  while (y < H - 4) {\n    let n = 4 + flr(rnd(3))\n    ledge(x, y, n, 3)\n    if (rnd(1) < 0.4) gems.push({ x: (x + flr(n / 2)) % W + 0.5, y: y + 1, got: false })\n    x = (x + n + 1 + flr(rnd(2))) % W\n    y += 1 + flr(rnd(2))\n  }\n  topY = y; flagX = x + 2\n  ledge(x, y, 6, 16)                         // the gold top\n  let data = load()\n  if (data) best = data.best\n  music(0)\n}\n\nfunction _update() {\n  if (btnp(5)) view = (view + 1) % VIEWS.length\n  if (!won) ticks++\n  let [sx] = stick(0)\n  px -= sx * 0.09                            // the camera looks along +z, so right is -x\n  if (abs(sx) > 0.1) { facing = sx > 0 ? 0.75 : 0.25; walk++ } else walk = 0\n  if (walk > 0 && grounded && walk % 14 == 0) sfx(3)\n\n  if (btnp(4) && grounded) { vy = 0.21; sfx(0) }\n  vy -= 0.01\n  py += vy\n  let [x, y, z, nx, ny, nz, g] = wrap_push(px, py, pz, 0.4)\n  px = x; py = y; pz = 1                     // stay on the ledges' line\n  grounded = g >= 0\n  if (grounded && vy < 0) vy = 0\n  if (ny < -0.5 && vy > 0) vy = 0\n  px = (px % W + W) % W                      // WRAPPING: back inside 0..W\n\n  for (let c of gems) if (!c.got && dist([wd(c.x, px), c.y + 0.4 - py], [0, 0]) < 0.9) { c.got = true; c.pop = 20; got++; sfx(1) }\n  if (!won && py > topY + 0.5 && wd(flagX + 0.5, px) < 1.5) {\n    won = true; sfx(5)\n    let secs = ticks / 60\n    if (best == null || secs < best) { best = secs; save({ best: best }) }\n  }\n}\n\nfunction _draw() {\n  let [name, k, along, push] = VIEWS[view]\n  bg(28, 12)\n  cam_set_curve(k, along, push)\n  cam_set_fov(0.13)                          // narrow and far back: less perspective, more Nebulus\n  cam_set_pos([px, py + 5, -24])\n  cam_set_lookat([px, py + 1, 1])\n  outline(0)\n  repeat(W, -1, -1)                          // the tower, its gems and flag, again on each side\n  map(0)\n  for (let c of gems) {\n    if (!c.got) vox(5, c.x, c.y, 1, 0, time() / 2, 0, 1.5)\n    else if (c.pop > 0) { c.pop--; fillp(1 - c.pop / 20, -1); vox(5, c.x, c.y + 1 - c.pop / 20, 1, 0, time() * 2, 0, 1.5); fillp() }\n  }\n  vox(7, flagX + 0.5, topY + 1, 1)\n  repeat()\n  let frame = walk == 0 ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - 0.4, pz, 0, facing)\n  outline()\n\n  print('gems ' + got + '/' + gems.length, 4, 4, 7, 0)\n  print(flr(ticks / 6) / 10 + 's', 252 - textw(flr(ticks / 6) / 10 + 's'), 4, 7, 0)\n  print('X: ' + name, 4, 244, 7, 0)\n  if (won) {\n    printc('THE TOP!', 100, 10, 0, 3)\n    printc('time ' + flr(ticks / 6) / 10 + 's   best ' + flr(best * 10) / 10 + 's', 130, 7, 0)\n  }\n}\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"name":"stone"},{"top":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"side":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"bottom":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"name":"brick"},{"top":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"side":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"bottom":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"name":"wood"},{"top":[15,15,15,15,15,15,15,15,15,15,15,15,15,31,9,15,15,15,15,15,15,15,15,15,15,15,15,31,15,15,15,15,9,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,31,15,31,15,15,15,15,31,15,15],"side":[15,15,15,15,15,15,15,15,15,15,15,15,15,31,9,15,15,15,15,15,15,15,15,15,15,15,15,31,15,15,15,15,9,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,31,15,31,15,15,15,