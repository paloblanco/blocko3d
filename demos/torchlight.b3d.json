{"version":1,"name":"torchlight","code":"// TORCHLIGHT: find the 8 coins in a dark dungeon. fog(0, 0, 0) fogs everything to black, and each\n// torch(x, y, z, near, far) punches a hole in the fog: clear within near blocks, dithering back to\n// the fog by far. Torches last one frame, so they're added every _draw (and can flicker).\n// X shows the same torches in mist, and with no fog (where torches do nothing).\n// Controls: left/right turn, up/down walk, O (Z or space) jumps, X changes the view.\n\nconst VIEWS = [\n  // name, fog color (-1: none), near, far, background\n  ['dark dungeon', 0, 0, 0, 0],\n  ['misty dungeon', 6, 2, 12, 6],\n  ['no fog (torches do nothing)', -1, 0, 0, 0],\n]\nlet view = 0\nlet px = 5.5, py = 2, pz = 5.5, vy = 0, grounded = false, yaw = 0, walk = 0\nlet rooms = [], posts = [], coins = [], got = 0\n\nfunction carve(x0, z0, x1, z1) { map_box(0, x0, 1, z0, x1, 3, z1, 0) }\n\nfunction _init() {\n  map_new(40, 4, 40)                         // map 0\n  map_box(0, 0, 0, 0, 39, 0, 39, 2)          // dirt floor\n  map_box(0, 0, 1, 0, 39, 2, 39, 4)          // solid brick with a stone cap, carved out below\n  map_box(0, 0, 3, 0, 39, 3, 39, 3)\n  // a 3 x 3 grid of rooms, joined by corridors 2 wide\n  for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) {\n    let x0 = 2 + c * 13 + (r * 3 + c) % 3, z0 = 2 + r * 13 + (c * 2 + r) % 3\n    let room = [x0, z0, x0 + 6 + (r + c) % 3, z0 + 6 + (r * 2 + c) % 2]\n    rooms.push(room)\n    carve(...room)\n  }\n  let mid = (rm) => [flr((rm[0] + rm[2]) / 2), flr((rm[1] + rm[3]) / 2)]\n  for (let r = 0; r < 3; r++) for (let c = 0; c < 3; c++) {\n    let [ax, az] = mid(rooms[r * 3 + c])\n    if (c < 2) { let [bx, bz] = mid(rooms[r * 3 + c + 1]); carve(ax, az, bx, az + 1); carve(bx, min(az, bz), bx + 1, max(az, bz) + 1) }\n    if (r < 2) { let [bx, bz] = mid(rooms[r * 3 + c + 3]); carve(ax, az, ax + 1, bz); carve(min(ax, bx), bz, max(ax, bx) + 1, bz + 1) }\n  }\n  // a torch post (a log) in a corner of each room, and a coin in each room but the first\n  for (let [i, [x0, z0, x1, z1]] of rooms.entries()) {\n    let [x, z] = i % 2 ? [x1, z0] : [x0, z1]\n    map_box(0, x, 1, z, x, 2, z, 12)\n    posts.push([x + 0.5, 3.3, z + 0.5])\n    if (i > 0) coins.push({ x: (i % 2 ? x0 + 1 : x1 - 1) + 0.5, y: 1, z: (i % 3 ? z0 + 1 : z1 - 1) + 0.5, got: false })\n  }\n  px = (rooms[0][0] + rooms[0][2]) / 2 + 0.5; pz = (rooms[0][1] + rooms[0][3]) / 2 + 0.5\n  music(0)\n}\n\nfunction _update() {\n  if (btnp(5)) view = (view + 1) % VIEWS.length\n  let [sx, sy] = stick(0)\n  yaw -= sx * 0.012\n  let [fx, , fz] = dir3(yaw)\n  px += fx * -sy * 0.09; pz += fz * -sy * 0.09\n  walk = abs(sy) > 0.1 ? walk + 1 : 0\n  if (walk > 0 && grounded && walk % 14 == 0) sfx(3)\n  if (btnp(4) && grounded) { vy = 0.2; sfx(0) }\n  vy -= 0.01; py += vy\n  let [x, y, z, nx, ny, nz, g] = mpush(0, px, py, pz, 0.4)\n  px = x; py = y; pz = z\n  grounded = g >= 0\n  if (grounded && vy < 0) vy = 0\n  for (let c of coins) if (!c.got && dist([c.x, c.y + 0.4, c.z], [px, py, pz]) < 0.9) {\n    c.got = true; c.pop = 20; got++; sfx(got == coins.length ? 5 : 1)\n  }\n}\n\nfunction _draw() {\n  let [name, fc, near, far, sky] = VIEWS[view]\n  bg(sky)\n  if (fc >= 0) fog(fc, near, far); else fog()\n  // the hero's torch, and one on every post, each flickering a little\n  torch(px, py, pz, 2.5 + rnd(0.2), 6)\n  for (let [x, y, z] of posts) torch(x, 2, z, 2 + rnd(0.4), 6 + rnd(0.4))\n\n  cam_orbit([px, py + 0.5, pz], yaw, -0.14, 7)\n  outline(0)\n  map(0)\n  for (let [x, y, z] of posts) sphere(x, y - 0.1, z, 0.2 + rnd(0.05), 9 + flr(rnd(2)))   // the flames\n  for (let c of coins) {\n    if (!c.got) vox(6, c.x, c.y, c.z, 0, time() / 2)\n    else if (c.pop > 0) { c.pop--; fillp(1 - c.pop / 20, -1); vox(6, c.x, c.y + 1 - c.pop / 20, c.z, 0, time() * 2); fillp() }\n  }\n  let frame = walk == 0 ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - 0.4, pz, 0, stick(0)[1] > 0.1 ? yaw + 0.5 : yaw)\n  outline()\n  fog()\n\n  print('coins ' + got + '/' + coins.length, 4, 4, 7, 0)\n  print('X: ' + name, 4, 244, 7, 0)\n  if (got == coins.length) printc('ALL COINS!', 110, 10, 0, 3)\n}\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"name":"stone"},{"top":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"side":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"bottom":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6