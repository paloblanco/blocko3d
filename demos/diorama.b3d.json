{"version":1,"name":"diorama","code":"// DIORAMA: find the 8 coins on a little island, 4 of them inside the house. An isometric view with\n// cam_set_ortho(w): w blocks across the screen at any distance, so nothing shrinks far away.\n// The camera is still placed like any other: hold O and it moves in close to the hero, so the\n// house's near walls (between the camera and the hero) aren't drawn and you can see inside.\n// Click a block to dig it out (mouse_ray works in orthographic views too).\n// Controls: arrows walk, hold O (Z or space) to see inside, X changes the view, click digs.\n\nconst VIEWS = [\n  // name, ortho width (0: perspective), yaw, pitch: the way the camera looks (as in cam_orbit)\n  ['isometric', 20, 0.125, -0.098],\n  ['top-down', 24, 0, -0.249],\n  ['side-on', 20, 0.25, 0],\n  ['perspective', 0, 0.125, -0.098],\n]\nlet view = 0\nlet px = 6.5, py = 2, pz = 6.5, vy = 0, facing = 0, walk = 0\nlet coins = [], got = 0, cut = 0\n\nfunction _init() {\n  map_new(24, 10, 24)                                  // map 0: the island\n  map_box(0, 0, 0, 0, 23, 0, 23, 2)                    // dirt\n  map_box(0, 0, 1, 0, 23, 1, 23, 1)                    // grass on top (stand at 2)\n  map_box(0, 0, 1, 0, 23, 1, 1, 7)                     // water along two edges\n  map_box(0, 0, 1, 0, 1, 1, 23, 7)\n  map_box(0, 18, 2, 3, 21, 2, 6, 3)                    // a stone step and a rock\n  map_box(0, 20, 3, 4, 21, 3, 5, 3)\n  // the house: brick walls 4 high with a door, a wooden floor, a roof\n  map_box(0, 9, 1, 9, 17, 1, 17, 5)\n  map_box(0, 9, 2, 9, 17, 5, 17, 4)\n  map_box(0, 10, 2, 10, 16, 5, 16, 0)                  // hollow it out\n  map_box(0, 9, 2, 12, 9, 3, 13, 0)                    // a door facing the hero's start (-x side)\n  map_box(0, 12, 3, 9, 14, 4, 9, 9)                    // windows\n  map_box(0, 17, 3, 12, 17, 4, 14, 9)\n  map_box(0, 8, 6, 8, 18, 6, 18, 14)                   // roof\n  map_box(0, 13, 2, 16, 16, 3, 16, 12)                 // a log bench inside\n  for (let [x, z] of [[11, 11], [15, 11], [11, 15], [14, 14]]) coins.push({ x: x + 0.5, y: 2, z: z + 0.5, got: false })\n  for (let [x, z] of [[4, 18], [20, 20], [19, 4.0], [5, 4]]) coins.push({ x: x + 0.5, y: 2, z: z + 0.5, got: false })\n  coins[6].y = 4                                       // the one on the rock\n  mouse_set_mode(1)\n  music(0)\n}\n\nfunction _update() {\n  if (btnp(5)) view = (view + 1) % VIEWS.length\n  let [, , yaw] = VIEWS[view]\n  // walk relative to the view: up is away from the camera, right is the camera's right\n  let [sx, sy] = stick(0)\n  let [fx, , fz] = dir3(yaw)\n  let dx = (-fz * sx - fx * sy) * 0.08, dz = (fx * sx - fz * sy) * 0.08\n  px += dx; pz += dz\n  if (abs(dx) + abs(dz) > 0.01) { facing = yaw_to(dx, dz); walk++ } else walk = 0\n  vy -= 0.01; py += vy\n  let [x, y, z, nx, ny, nz, g] = mpush(0, px, py, pz, 0.4)\n  px = x; py = y; pz = z\n  if (g >= 0 && vy < 0) vy = 0\n  if (py < -5) { px = 6.5; py = 3; pz = 6.5; vy = 0 }\n\n  // hold O: the camera slides in close, so what's between it and the hero isn't drawn\n  cut = lerp(cut, btn(4) ? 1 : 0, 0.15)\n\n  // click: dig out the block under the cursor (not the bottom layer)\n  if (btnp(19)) {\n    let [ox, oy, oz, rx, ry, rz] = mouse_ray()\n    let hit = mray(0, ox, oy, oz, rx, ry, rz, 200)\n    if (hit[0] && hit[2] > 0) { mset(0, hit[1], hit[2], hit[3], 0); sfx(2) }\n  }\n\n  for (let c of coins) if (!c.got && dist([c.x, c.y + 0.4, c.z], [px, py, pz]) < 0.9) { c.got = true; got++; sfx(got == coins.length ? 5 : 1) }\n}\n\nfunction _draw() {\n  let [name, w, yaw, pitch] = VIEWS[view]\n  bg(12)\n  cam_set_ortho(w)\n  cam_set_fov(0.12)                                    // only used by the perspective view\n  // far back normally (outside the island); 3 blocks from the hero when cutting in\n  cam_orbit([px, py + 0.5, pz], yaw, pitch, lerp(60, 3, cut))\n  outline(0)\n  map(0)\n  for (let c of coins) if (!c.got) vox(6, c.x, c.y, c.z, 0, time() / 2)\n  vox(8, 4.5, 2, 12.5, 0, 0.1, 0, 3)\n  vox(8, 20.5, 2, 14.5, 0, 0.6, 0, 3)\n  let frame = walk == 0 ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - 0.4, pz, 0, facing)\n  outline()\n\n  print('coins ' + got + '/' + coins.length, 4, 4, 7, 0)\n  print('X: ' + name, 4, 244, 7, 0)\n  print('hold O: look inside', 252 - textw('hold O: look inside'), 244, 7, 0)\n  if (got == coins.length) printc('ALL COINS!', 110, 10, 0, 3)\n}\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"name":"stone"},{"top":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"side