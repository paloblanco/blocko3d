{"version":1,"name":"starter","code":"// STARTER: a small platformer to turn into your own game.\n// The starter kit (change any of it in the Tile, Vox and Sfx tabs):\n//   tiles  1 grass  2 dirt  3 stone  4 brick  5 wood  6 sand  7 water  8 snow\n//          9 metal  10 lava  11 leaves  12 log  13 checker  14 roof  15 bounce pad  16 gold\n//   vox    0 hero  1 hero step a  2 hero step b  3 guard step a  4 guard step b\n//          5 gem  6 coin  7 flag  8 tree\n//   sfx    0 jump  1 coin  2 hit  3 step  4 start  5 win  6 lose  7 powerup\n//   music  music(0) plays the song (patterns 0-1, sounds 8-12)\n// Controls: arrows or d-pad move, Z or space (button 4, O) jumps.\n\nlet px, py, pz, vy, grounded        // the hero: position (center of a 0.4 ball) and fall speed\nlet facing = 0, walk = 0            // the hero's yaw (in turns) and walk-cycle clock\nlet coins, got, guards\nlet ticks = 0, won = false, best = null\n\nfunction _init() {\n  build_level()\n  // coins sit on the floor: y is the height of the top they sit on\n  coins = [[7, 3, 15], [3, 5, 24], [12, 5, 24], [8, 4, 32], [3, 5, 38], [5, 10, 53]]\n    .map(([x, y, z]) => ({ x: x + 0.5, y: y, z: z + 0.5, got: false }))\n  got = 0\n  guards = [{ x: 3, z: 32.5, dir: 1 }]\n  let data = load()\n  if (data) best = data.best\n  respawn()\n  music(0)\n}\n\n// The level is map 0, built from boxes: map_box(map, x0, y0, z0, x1, y1, z1, tile).\n// A block at height y has its top at y + 1, so a floor box ending at y = 1 is stood on at y = 2.\n// The course runs along +z.\nfunction build_level() {\n  map_new(16, 13, 60)                     // map 0: 16 wide (x), 13 tall (y), 60 long (z)\n  map_box(0, 0, 0, 0, 15, 0, 59, 10)      // lava under everything\n  map_box(0, 0, 1, 0, 15, 1, 11, 1)       // start meadow (top at 2)\n  map_box(0, 0, 1, 2, 15, 1, 3, 13)       // checkered start line\n  map_box(0, 1, 2, 7, 1, 4, 7, 12)        // a tree: log trunk...\n  map_box(0, 0, 5, 6, 2, 6, 8, 11)        // ...and leaves\n  map_box(0, 6, 1, 14, 9, 2, 16, 3)       // stepping stone (top at 3)\n  map_box(0, 4, 1, 18, 11, 2, 19, 4)      // brick stairs: top at 3...\n  map_box(0, 4, 1, 20, 11, 3, 21, 4)      // ...4\n  map_box(0, 1, 1, 22, 5, 4, 27, 5)       // two wooden decks (top at 5) with lava between\n  map_box(0, 10, 1, 22, 14, 4, 27, 5)\n  map_box(0, 0, 1, 29, 15, 3, 35, 3)      // stone yard where a guard walks (top at 4)\n  map_box(0, 2, 1, 38, 4, 4, 39, 8)       // snowy pillars in a row, each one higher (tops at 5, 6, 7)\n  map_box(0, 2, 1, 41, 4, 5, 42, 8)\n  map_box(0, 2, 1, 44, 4, 6, 45, 8)\n  map_box(0, 5, 1, 44, 9, 6, 47, 6)       // sandy ledge beside the last pillar (top at 7), with a bounce pad\n  map_box(0, 7, 6, 46, 8, 6, 46, 15)\n  map_box(0, 4, 1, 51, 11, 9, 57, 9)      // high metal goal (top at 10)\n  map_box(0, 4, 9, 51, 11, 9, 57, 16)     // gold floor on top\n  map_box(0, 4, 9, 51, 11, 9, 51, 13)     // checkered finish edge\n}\n\nfunction respawn() {\n  px = 8; py = 2.4; pz = 5; vy = 0\n}\n\nfunction hit() {\n  sfx(2)\n  respawn()\n}\n\nfunction _update() {\n  if (!won) ticks++\n\n  // move: the camera looks along +z, so up on the stick is +z and right is -x\n  let [sx, sy] = stick(0)\n  let dx = -sx * 0.09, dz = -sy * 0.09\n  px += dx; pz += dz\n  if (abs(dx) + abs(dz) > 0.01) {\n    facing = yaw_to(dx, dz)          // turn the model's front (+z) toward the movement\n    walk++\n    if (grounded && walk % 12 == 0) sfx(3)\n  } else walk = 0\n\n  // jump and fall\n  if (btnp(4) && grounded) { vy = 0.2; sfx(0) }\n  vy -= 0.01\n  py += vy\n\n  // collision: push the hero's ball out of map 0\n  let [x, y, z, nx, ny, nz, ground] = mpush(0, px, py, pz, 0.4)\n  px = x; py = y; pz = z\n  grounded = ground >= 0\n  if (grounded && vy < 0) vy = 0\n  if (ny < -0.5 && vy > 0) vy = 0    // bumped a ceiling\n\n  // what's under the feet\n  let [t] = mgetw(0, px, py - 0.5, pz)\n  if (t == 10) hit()                                  // lava\n  if (t == 15 && grounded) { vy = 0.32; sfx(7) }     // bounce pad\n  if (py < 0) hit()\n\n  // the guard walks back and forth across the stone yard\n  for (let g of guards) {\n    g.x += g.dir * 0.05\n    if (g.x < 1.5 || g.x > 14.5) g.dir = -g.dir\n    if (dist([g.x, 4, g.z], [px, py, pz]) < 0.9) hit()\n  }\n\n  for (let c of coins) {\n    if (!c.got && dist([c.x, c.y + 0.4, c.z], [px, py, pz]) < 0.8) {\n      c.got = true\n      got++\n      sfx(1)\n    }\n  }\n\n  // reach the flag with every coin to win\n  if (!won && got == coins.length && dist([8, 10, 54], [px, py, pz]) < 1.5) {\n    won = true\n    sfx(5)\n    let secs = ticks / 60\n    if (best == null || secs < best) { best = secs; save({ best: best }) }\n  }\n}\n\nfunction _draw() {\n  bg(12)\n  cam_set_pos([px, py + 3.5, pz - 6])\n  cam_set_lookat([px, py, pz + 3])\n  outline(0)\n  map(0)\n\n  // the hero, feet at the bottom of the ball; walk cycle 1, 0, 2, 0\n  let frame = walk == 0 ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - 0.4, pz, 0, facing)\n\n  for (let g of guards) vox(3 + flr(time() * 6) % 2, g.x, 4, g.z, 0, g.dir > 0 ? 0.25 : 0.75)\n  for (let c of coins) if (!c.got) vox(6, c.x, c.y, c.z, 0, time() / 2)\n  vox(7, 8, 10, 54)\n  vox(8, 13, 2, 8)\n  outline()\n\n  // the HUD, in screen pixels (256 x 256)\n  print('coins ' + got + '/' + coins.length, 4, 4, 7, 0)\n  print(flr(ticks / 6) / 10 + 's', 220, 4, 7, 0)\n  if (got == coins.length && !won) printc('to the flag!', 20, 10, 0)\n  if (won) {\n    printc('YOU WIN!', 100, 10, 0, 3)\n    printc('time ' + flr(ticks / 6) / 10 + 's   best ' + flr(best * 10) / 10 + 's', 130, 7, 0)\n  }\n}\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"name":"stone"},{"top":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"side":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"bottom":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"name":"brick"},{"top":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"side":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"bottom":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"name":"wood"},{"top":[15,15,15,15,15,15,15,15