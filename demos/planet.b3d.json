{"version":1,"name":"tiny planet","code":"// TINY PLANET: collect the 8 gems on a world you can walk all the way around.\n// cam_set_curve(k, 'xz') bends the picture down with distance from the camera's target in x and z,\n// so a flat map looks like a small round planet. X shows the other curves: cam_set_curve(k) rolls\n// away along the view, 'x' rolls along the world's x whichever way you face, and a negative k\n// bends up instead. Only the picture bends: collision and\n// positions stay flat. The map is 32 x 32 and wraps: walk off one edge and you come back on the\n// other. repeat(32, -1, 32) draws everything again 32 blocks away in x and z, so the world looks\n// endless; game code wraps the hero and collides across the edges (see WRAPPING below).\n// Controls: left/right turn, up/down walk, O (Z or space) jumps, X changes the view.\n\nconst N = 32                               // the map is N x N and repeats every N blocks\nconst VIEWS = [\n  // name, curve k, along\n  ['planet', 0.05, 'xz'],\n  ['rolling log', 0.03, 'view'],\n  ['roll along x', 0.03, 'x'],\n  ['inverse roll', -0.02, 'view'],\n  ['flat (curve off)', 0, 'view'],\n]\nlet view = 0\nlet px = 16.5, py = 6, pz = 16.5, vy = 0, grounded = false, yaw = 0, walk = 0\nlet trees = [], gems = [], got = 0\n\n// ground height, made of waves that repeat every 32 blocks so the edges meet\nfunction height(x, z) {\n  return mid(1, flr(3 + 1.5 * sin(x / 32) * cos(z / 32) + sin(z / 16 + 0.1) * 0.8 + cos(x / 16) * 0.6), 5)\n}\n\n// ---- WRAPPING (all of it): repeat() draws the copies; the hero's position wraps, collision and\n// pickups look across the edges\n// mpush on map 0 as if it repeated every N: also push out from the copy across an edge within a block\nfunction wrap_push(x, y, z, r) {\n  let ox = x < 1 ? N : x > N - 1 ? -N : 0, oz = z < 1 ? N : z > N - 1 ? -N : 0\n  let res = mpush(0, x, y, z, r)\n  for (let [sx, sz] of [[ox, 0], [0, oz], [ox, oz]]) {   // across x, across z, across the corner\n    if (!sx && !sz) continue\n    let q = mpush(0, res[0] + sx, res[1], res[2] + sz, r)\n    res = [q[0] - sx, q[1], q[2] - sz, q[3] || res[3], q[4] || res[4], q[5] || res[5], max(q[6], res[6])]\n  }\n  return res\n}\n// the distance between two coordinates the short way round\nfunction wd(a, b) { let d = abs(a - b) % N; return min(d, N - d) }\n// ----\n\nfunction _init() {\n  map_new(N, 8, N)\n  for (let x = 0; x < N; x++) for (let z = 0; z < N; z++) {\n    let h = height(x, z)\n    map_box(0, x, 0, z, x, h - 1, z, 2)\n    mset(0, x, h - 1, z, h <= 1 ? 7 : h >= 5 ? 8 : 1)   // water low, snow high, grass between\n  }\n  srand(3)\n  while (trees.length < 14) {\n    let x = flr(rnd(N)), z = flr(rnd(N)), h = height(x, z)\n    if (h >= 2 && h <= 4 && dist([x, z], [16, 16]) > 3) trees.push([x + 0.5, h, z + 0.5, rnd(1)])\n  }\n  while (gems.length < 8) {\n    let x = flr(rnd(N)), z = flr(rnd(N))\n    if (dist([x, z], [16, 16]) > 6) gems.push({ x: x + 0.5, y: height(x, z) + 0.3, z: z + 0.5, got: false })\n  }\n  py = height(16, 16) + 0.4\n  music(0)\n}\n\nfunction _update() {\n  if (btnp(5)) view = (view + 1) % VIEWS.length\n  let [sx, sy] = stick(0)\n  yaw -= sx * 0.012\n  let [fx, , fz] = dir3(yaw)\n  px += fx * -sy * 0.1; pz += fz * -sy * 0.1\n  walk = abs(sy) > 0.1 ? walk + 1 : 0\n  if (walk > 0 && grounded && walk % 14 == 0) sfx(3)\n\n  if (btnp(4) && grounded) { vy = 0.2; sfx(0) }\n  vy -= 0.01\n  py += vy\n  let [x, y, z, nx, ny, nz, g] = wrap_push(px, py, pz, 0.4)\n  px = x; py = y; pz = z\n  grounded = g >= 0\n  if (grounded && vy < 0) vy = 0\n  px = (px % N + N) % N; pz = (pz % N + N) % N                   // WRAPPING: back inside 0..N\n\n  for (let c of gems) if (!c.got && dist([wd(c.x, px), c.y + 0.4 - py, wd(c.z, pz)], [0, 0, 0]) < 0.9) {\n    c.got = true; c.pop = 20; got++\n    sfx(got == gems.length ? 5 : 1)\n  }\n}\n\nfunction _draw() {\n  let [name, k, along] = VIEWS[view]\n  bg(1, 12)\n  cam_set_curve(k, along)\n  cam_orbit([px, py + 1, pz], yaw, -0.12, 6)\n  outline(0)\n  repeat(N, -1, N)                         // the world, its trees and gems, again on every side\n  map(0)\n  for (let [x, y, z, r] of trees) vox(8, x, y, z, 0, r, 0, 3)\n  for (let c of gems) {\n    if (!c.got) vox(5, c.x, c.y, c.z, 0, time() / 2, 0, 1.5)\n    else if (c.pop > 0) { c.pop--; fillp(1 - c.pop / 20, -1); vox(5, c.x, c.y + 1 - c.pop / 20, c.z, 0, time() * 2, 0, 1.5); fillp() }\n  }\n  repeat()\n  let frame = walk == 0 ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - 0.4, pz, 0, stick(0)[1] > 0.1 ? yaw + 0.5 : yaw)\n  outline()\n\n  print('gems ' + got + '/' + gems.length, 4, 4, 7, 0)\n  print('X: ' + name, 4, 244, 7, 0)\n  if (got == gems.length) printc('ALL GEMS!', 110, 10, 0, 3)\n}\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom