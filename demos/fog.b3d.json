{"version":1,"name":"fog valley","code":"// FOG VALLEY: find the 8 coins hidden in the fog.\n// fog(c, near, far) makes 3D draws dither into color c from near to far blocks away. It's draw\n// state, like pal() and outline(), and bg(c) of the same color lets the fog melt into the sky.\n// Controls: left/right turn, up/down walk, O (Z or space) jumps, X changes the weather.\n\nconst W = 96, D = 96                      // the valley: 96 x 96 blocks\nconst WEATHER = [\n  // name, fog color, near, far (blocks from the camera), sky\n  ['morning mist', 6, 6, 22, 6],\n  ['dusk', 13, 4, 18, 13],\n  ['swamp', 3, 2, 13, 3],\n  ['night', 1, 4, 12, 1],\n  ['clear (fog off)', -1, 0, 0, 12],\n]\nlet weather = 0\nlet px, py, pz, vy = 0, grounded = false, yaw = 0, walk = 0\nlet trees = [], coins = [], got = 0, ticks = 0, done = false\n\n// ground height of column x, z: rolling hills between 1 and 8\nfunction height(x, z) {\n  return mid(1, flr(4 + 1.5 * sin(x / 29) + 1.5 * cos(z / 23) + sin((x + z) / 17) + 0.5 * sin(x / 7) * cos(z / 9)), 8)\n}\n\nfunction _init() {\n  map_new(W, 10, D)                       // map 0\n  for (let x = 0; x < W; x++) for (let z = 0; z < D; z++) {\n    let h = height(x, z)\n    map_box(0, x, 0, z, x, h - 1, z, h <= 2 ? 3 : 2)   // stone and dirt underneath\n    if (h <= 2) map_box(0, x, 1, z, x, 2, z, 7)        // low ground is a lake (top at 3)\n    else mset(0, x, h - 1, z, h == 3 ? 6 : 1)          // sand by the water, grass above\n  }\n  // trees and coins at seeded random spots, so the valley is the same every time\n  srand(7)\n  while (trees.length < 70) {\n    let x = flr(rnd(W)), z = flr(rnd(D)), h = height(x, z)\n    if (h >= 4) trees.push([x + 0.5, h, z + 0.5, rnd(1)])\n  }\n  while (coins.length < 8) {\n    let x = 4 + flr(rnd(W - 8)), z = 4 + flr(rnd(D - 8)), h = height(x, z)\n    if (h >= 3 && dist([x, z], [48, 48]) > 14) coins.push({ x: x + 0.5, y: max(h, 3), z: z + 0.5, got: false })\n  }\n  // start on the nearest hilltop to the middle\n  let sx = 48, sz = 48\n  for (let r = 0; r < 40 && height(sx, sz) < 6; r++)\n    for (let x = 48 - r; x <= 48 + r; x++) for (let z = 48 - r; z <= 48 + r; z++)\n      if (height(sx, sz) < 6 && height(x, z) >= 6) { sx = x; sz = z }\n  px = sx + 0.5; pz = sz + 0.5; py = height(sx, sz) + 0.4\n  music(0)\n}\n\nfunction _update() {\n  if (btnp(5)) weather = (weather + 1) % WEATHER.length\n  if (!done) ticks++\n\n  // tank controls: turn with left/right, walk with up/down\n  let [sx, sy] = stick(0)\n  yaw -= sx * 0.012                   // yaw turns toward +x, which is screen-left from behind\n  let [fx, , fz] = dir3(yaw)\n  px += fx * -sy * 0.1; pz += fz * -sy * 0.1\n  walk = abs(sy) > 0.1 ? walk + 1 : 0\n  if (walk > 0 && grounded && walk % 14 == 0) sfx(3)\n\n  if (btnp(4) && grounded) { vy = 0.2; sfx(0) }\n  vy -= 0.01\n  py += vy\n  let [x, y, z, nx, ny, nz, g] = mpush(0, px, py, pz, 0.4)\n  px = mid(0.5, x, W - 0.5); py = y; pz = mid(0.5, z, D - 0.5)\n  grounded = g >= 0\n  if (grounded && vy < 0) vy = 0\n\n  // tree trunks push you out sideways\n  for (let [tx, ty, tz] of trees) {\n    let d = dist([tx, tz], [px, pz])\n    if (d < 0.6 && py < ty + 2.5) { px = tx + (px - tx) / d * 0.6; pz = tz + (pz - tz) / d * 0.6 }\n  }\n\n  for (let c of coins) if (!c.got && dist([c.x, c.y + 0.4, c.z], [px, py, pz]) < 0.9) {\n    c.got = true; got++\n    sfx(got == coins.length ? 5 : 1)\n    if (got == coins.length) done = true\n  }\n}\n\nfunction _draw() {\n  let [name, fc, near, far, sky] = WEATHER[weather]\n  bg(sky)\n  if (fc >= 0) fog(fc, near, far); else fog()\n  cam_orbit([px, py + 1, pz], yaw, -0.07, 5)\n  outline(0)\n  map(0)\n  for (let [x, y, z, r] of trees) vox(8, x, y, z, 0, r, 0, 3)\n  for (let c of coins) if (!c.got) vox(6, c.x, c.y, c.z, 0, time() / 2)\n  let frame = walk == 0 ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - 0.4, pz, 0, sy_facing())\n  outline()\n  fog()\n\n  print('coins ' + got + '/' + coins.length, 4, 4, 7, 0)\n  print('X: ' + name, 4, 244, 7, 0)\n  print(flr(ticks / 6) / 10 + 's', 252 - textw(flr(ticks / 6) / 10 + 's'), 4, 7, 0)\n  if (done) printc('ALL FOUND!', 110, 10, 0, 3)\n}\n\n// the hero faces the way he walks: forward, or back toward the camera when backing up\nfunction sy_facing() { return stick(0)[1] > 0.1 ? yaw + 0.5 : yaw }\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"name":"stone"},{"top":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"side":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8