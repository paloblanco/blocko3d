{"version": 1, "vox": [], "sfx": ["0300001825013235180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "0300001e6501a635180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "0400000e2300c225180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "030000244302b425180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "0200003003518000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000"], "music": [], "name": "builder", "code": "// Builder: build on a plot, block by block. Your build is saved, so it's still here next time.\n// Mouse: left-click places the selected block on the face you point at, right-click digs.\n// The wheel, O, or a click on the hotbar picks a block. X switches between building and digging\n// (handy on a touch screen, where a tap is a left click). Hold X to clear the plot.\n// Arrows turn and raise the camera.\n// Shows: mray() and the face it hit (place a block at the cell + the face direction), mset(),\n// a hotbar drawn with rectfill/print and clicked through mouse_pos(), save()/load() for a build.\n// map 0 = the plot, 16 x 8 x 16. Tiles 1-9 are building blocks; 10 is the ground (can't be dug).\n// sounds: 0 place, 1 dig, 2 can't, 3 switch mode, 4 pick a block\n\nconst W = 16, H = 8, D = 16\nconst BLOCKS = [1, 2, 3, 4, 5, 6, 7, 8, 9]        // the hotbar: tile numbers\nconst ICON = [0, 11, 4, 6, 8, 15, 20, 3, 10, 12]  // a color for each tile's hotbar square\nlet sel = 0, digging = false, wheel = 0\nlet ang = 0.12, lift = 0.11, target = null\nlet dirty = false, saveT = 0, clearT = 0\n\nfunction _init() {\n  mouse_set_mode(1)                               // click mode; on touch screens a tap is a click\n  bg(12)\n  let d = load()\n  if (d && d.blocks && d.blocks.length == W * H * D) {\n    // one character per cell, in the same order as the map's data: x fastest, then y, then z\n    for (let i = 0; i < d.blocks.length; i++)\n      mset(0, i % W, flr(i / W) % H, flr(i / (W * H)), parseInt(d.blocks[i], 36))\n  }\n}\n\nfunction saveBuild() {\n  let s = ''\n  for (let z = 0; z < D; z++) for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) s += mget(0, x, y, z).toString(36)\n  save({ blocks: s })\n}\n\nfunction pick(i) { sel = (i + BLOCKS.length) % BLOCKS.length; sfx(4) }\n\nfunction _update() {\n  if (btn(0)) ang -= 0.005\n  if (btn(1)) ang += 0.005\n  if (btn(2)) lift = min(lift + 0.003, 0.22)\n  if (btn(3)) lift = max(lift - 0.003, 0.02)\n  if (btnp(4)) pick(sel + 1)\n  wheel += mouse_wheel()                          // trackpads scroll in fractions of a notch\n  while (wheel >= 1) { wheel--; pick(sel + 1) }\n  while (wheel <= -1) { wheel++; pick(sel - 1) }\n\n  // X: tap to switch build / dig, hold to clear the plot\n  if (btn(5)) {\n    if (++clearT == 90) {\n      for (let z = 0; z < D; z++) for (let y = 1; y < H; y++) for (let x = 0; x < W; x++) mset(0, x, y, z, 0)\n      dirty = true; sfx(1)\n    }\n  } else {\n    if (clearT > 0 && clearT < 90) { digging = !digging; sfx(3) }\n    clearT = 0\n  }\n\n  let [mx, my] = mouse_pos()\n  if (my >= 229 && mx >= 32 && mx < 32 + BLOCKS.length * 22) {     // over the hotbar\n    target = null\n    if (btnp(19)) pick(flr((mx - 32) / 22))\n  } else {\n    let h = mray(0, ...mouse_ray())\n    target = h[0] ? h : null\n    if (target && (btnp(19) || btnp(20))) {\n      let [t, x, y, z, nx, ny, nz] = target\n      if (btnp(20) || digging) {                  // right-click always digs\n        if (t != 10) { mset(0, x, y, z, 0); sfx(1); dirty = true } else sfx(2)\n      } else {\n        let [px, py, pz] = [x + nx, y + ny, z + nz]\n        if (px >= 0 && py >= 0 && pz >= 0 && px < W && py < H && pz < D && !mget(0, px, py, pz)) {\n          mset(0, px, py, pz, BLOCKS[sel]); sfx(0); dirty = true\n        } else sfx(2)\n      }\n    }\n  }\n  if (dirty && ++saveT >= 30) { saveBuild(); dirty = false; saveT = 0 }   // at most twice a second\n}\n\n// a wire box around block (x, y, z), a little outside it\nfunction box(x, y, z, c) {\n  let e = 0.03, p = (k) => [x - e + (k & 1) * (1 + 2 * e), y - e + (k >> 1 & 1) * (1 + 2 * e), z - e + (k >> 2 & 1) * (1 + 2 * e)]\n  for (let i = 0; i < 8; i++) for (let bit of [1, 2, 4]) if (!(i & bit)) line3(...p(i), ...p(i | bit), c)\n}\n\nfunction _draw() {\n  let cx = W / 2, cz = D / 2, r = 17\n  cam_set_pos([cx + sin(ang) * cos(lift) * r, 1 + sin(lift) * r, cz + cos(ang) * cos(lift) * r])\n  cam_set_lookat([cx, 1.5, cz])\n  outline(0)\n  map(0)\n  outline()\n  if (target) {\n    let [t, x, y, z, nx, ny, nz] = target\n    if (digging) box(x, y, z, 8)\n    else box(x + nx, y + ny, z + nz, 7)\n  }\n\n  // hotbar: one square per block, the selected one framed in white\n  rectfill(28, 228, 32 + BLOCKS.length * 22, 253, 0)\n  for (let i = 0; i < BLOCKS.length; i++) {\n    let x = 32 + i * 22\n    rectfill(x + 2, 232, x + 19, 249, ICON[BLOCKS[i]])\n    if (i == sel) rect(x, 230, x + 21, 251, 7)\n  }\n  print(digging ? 'DIG' : 'BUILD', 4, 4, digging ? 8 : 11, 0)\n  let hint = 'X: ' + (digging ? 'build' : 'dig') + '  hold X: clear'\n  print(hint, 252 - hint.length * 7, 4, 6, 0)\n}\n", "tiles": [null, {"top": [3, 11, 11, 11, 3, 11, 27, 11, 3, 11, 11, 11, 11, 27, 3, 27, 27, 11, 11, 11, 3, 3, 3, 11, 3, 11, 11, 11, 11, 27, 27, 3, 11, 27, 11, 11, 11, 27, 27, 11, 27, 27, 3, 11, 11, 3, 11, 3, 11, 27, 11, 3, 27, 3, 27, 3, 11, 3, 11, 3, 27, 11, 3, 11], "side": [11, 11, 11, 11, 11, 11, 11, 11, 4, 11, 11, 4, 11, 11, 4, 11, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4