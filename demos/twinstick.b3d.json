{"version":1,"name":"twin stick","code":"// TWIN STICK: survive the guards in the arena.\n// Phone: left stick moves, right stick aims and fires, O drops a bomb.\n// Computer: arrows move, the mouse aims (hold the button to fire), X fires ahead, Z/O bombs.\n// Gamepad: left stick moves, right stick aims and fires, B/Y fires ahead, A/X bombs.\nconst N = 24                      // the arena is N x N blocks\nlet state, px, pz, face, lives, hurt, score, best, bullets, foes, blasts\nlet spawnT, fireT, bombT, walkT, aimT\n\nfunction _init() {\n  touch_set_mode(1, 1)            // analog circles on both sides of a phone screen\n  mouse_set_mode(1)               // the mouse aims\n  map_new(N, 3, N)\n  map_box(0, 0, 0, 0, N - 1, 0, N - 1, 3)               // stone floor\n  map_box(0, 0, 1, 0, N - 1, 2, N - 1, 4)               // brick walls...\n  map_box(0, 1, 1, 1, N - 2, 2, N - 2, 0)               // ...hollowed out\n  for (let [x, z] of [[6, 6], [17, 6], [6, 17], [17, 17], [11, 11]]) map_box(0, x, 1, z, x + 1, 2, z + 1, 9)\n  best = load() || 0\n  state = 'title'\n}\n\nfunction start() {\n  px = N / 2; pz = 4; face = 0; lives = 3; hurt = 0; score = 0\n  bullets = []; foes = []; blasts = []\n  spawnT = 60; fireT = 0; bombT = 0; walkT = 0; aimT = 0\n  state = 'play'\n  sfx(4); music(0)\n}\n\nfunction solid(x, z) { return mget(0, flr(x), 1, flr(z)) !== 0 }\n\nfunction fire(yaw) {\n  face = yaw\n  if (fireT > 0) return\n  let [dx, , dz] = dir3(yaw, 0)\n  bullets.push({ x: px + dx * 0.5, z: pz + dz * 0.5, dx: dx * 0.35, dz: dz * 0.35, life: 45 })\n  fireT = 7\n  sfx(3, 3)\n}\n\nfunction _update() {\n  if (state !== 'play') {\n    if (btnp(4) || btnp(5)) start()\n    return\n  }\n  fireT--; bombT--; hurt--; aimT--\n  // move: the camera looks along +z, so screen right is -x and screen down is -z\n  let [sx, sy] = stick(0)\n  if (sx || sy) {\n    let [x, , z] = mpush(0, px - sx * 0.09, 1.4, pz - sy * 0.09, 0.35)\n    px = x; pz = z; walkT++\n    if (aimT <= 0) face = yaw_to(-sx, -sy)\n  }\n  // aim and fire: the right stick, the mouse, or X straight ahead\n  let [ax, ay] = stick(1)\n  if (abs(ax) + abs(ay) > 0.3) { aimT = 20; fire(yaw_to(-ax, -ay)) }\n  else if (btn(19)) {\n    let [ox, oy, oz, rx, ry, rz] = mouse_ray()\n    if (ry < 0) { let t = (1.4 - oy) / ry; aimT = 20; fire(yaw_to(ox + rx * t - px, oz + rz * t - pz)) }\n  } else if (btn(5)) fire(face)\n  // bomb: clears the guards nearby\n  if (btnp(4) && bombT <= 0) {\n    bombT = 300; blasts.push({ x: px, z: pz, t: 0 }); sfx(7)\n    foes = foes.filter((f) => dist([f.x, f.z], [px, pz]) > 4.5 || (score++, false))\n  }\n  for (let b of blasts) b.t++\n  blasts = blasts.filter((b) => b.t < 20)\n  // bullets fly until they hit a wall, a guard or run out\n  for (let b of bullets) {\n    b.x += b.dx; b.z += b.dz; b.life--\n    if (solid(b.x, b.z)) b.life = 0\n    for (let f of foes) if (b.life > 0 && dist([f.x, f.z], [b.x, b.z]) < 0.55) { f.dead = true; b.life = 0; score++; sfx(1) }\n  }\n  bullets = bullets.filter((b) => b.life > 0)\n  foes = foes.filter((f) => !f.dead)\n  // guards appear at the edge, faster as the score climbs, and walk at the hero\n  if (--spawnT <= 0) {\n    spawnT = max(18, 80 - score)\n    let x, z\n    do { x = 2 + rnd(N - 4); z = 2 + rnd(N - 4) } while (dist([x, z], [px, pz]) < 8 || solid(x, z))\n    foes.push({ x, z, sp: 0.03 + rnd(0.02) + score * 0.0004 })\n  }\n  for (let f of foes) {\n    let dx = px - f.x, dz = pz - f.z, d = max(0.01, sqrt(dx * dx + dz * dz))\n    let [x, , z] = mpush(0, f.x + dx / d * f.sp, 1.4, f.z + dz / d * f.sp, 0.35)\n    f.x = x; f.z = z; f.yaw = yaw_to(dx, dz)\n    if (d < 0.7 && hurt <= 0) {\n      lives--; hurt = 90; sfx(2)\n      if (lives <= 0) {\n        state = 'over'; music(-1); sfx(6)\n        if (score > best) { best = score; save(best) }\n      }\n    }\n  }\n}\n\nfunction _draw() {\n  bg(1)\n  let cx = state === 'title' ? N / 2 : px, cz = state === 'title' ? N / 2 : pz\n  cam_orbit([cx, 1, cz], 0, -0.18, state === 'title' ? 18 : 11)\n  outline(0)\n  map(0)\n  if (state !== 'title') {\n    if (hurt <= 0 || flr(hurt / 4) % 2) vox(state === 'play' ? 1 + flr(walkT / 8) % 2 : 0, px, 1, pz, 0, face, 0, 1.3)\n    for (let f of foes) vox(3 + flr(t() * 6) % 2, f.x, 1, f.z, 0, f.yaw, 0, 1.3)\n    outline()\n    for (let b of bullets) sphere(b.x, 1.5, b.z, 0.13, 10)\n    for (let b of blasts) {\n      for (let k = 0; k < 16; k++) { let [dx, , dz] = dir3(k / 16, 0), r = b.t * 0.25; cube(b.x + dx * r, 1.3, b.z + dz * r, 0.3, 9) }\n    }\n  }\n  outline()\n  if (state === 'title') {\n    rectfill(14, 70, 241, 160, 0); rect(14, 70, 241, 160, 7)\n    printc('TWIN STICK', 82, 10, 0, 3)\n    printc('left stick moves, right aims', 116, 7)\n    printc('O: bomb   press O or X', 128, 6)\n    printc('best ' + best, 144, 12)\n    return\n  }\n  print('score ' + score, 4, 4, 7, 0)\n  print('lives ' + lives, 4, 16, 8, 0)\n  printc(bombT <= 0 ? 'bomb ready' : 'bomb ' + ceil(bombT / 60), 242, bombT <= 0 ? 11 : 5, 0)\n  if (state === 'over') {\n    rectfill(56, 96, 199, 150, 0); rect(56, 96, 199, 150, 7)\n    printc('GAME OVER', 104, 8, 0, 2)\n    printc('score ' + score + '   best ' + best, 126, 7)\n    printc('O or X: again', 138, 6)\n  }\n}\n","tiles":[null,{"top":[3,11,11,11,3,11,11,11,27,11,27,11,11,11,11,11,11,11,11,11,11,11,11,3,11,11,3,11,11,11,27,11,11,11,11,11,11,11,27,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,11,27,11,11,11,11,3,11,11,11],"side":[11,11,11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"grass"},{"top":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"side":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"bottom":[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,5,4,20,4,4,4,20,4,4,4,4,5,4,4,4,4,4,4,4,4,4,5,20,5,4,4,4,4,4,4,5,4,4,4,4,4,4,4,4,4,4,4,4,4,5,4,4],"name":"dirt"},{"top":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"side":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"bottom":[6,13,13,6,6,6,6,6,6,6,6,13,6,6,6,13,13,6,6,6,13,6,6,13,5,5,5,5,5,6,13,6,6,13,6,6,6,5,6,6,13,13,6,13,6,5,13,6,6,6,6,6,6,5,6,6,13,6,6,13,6,5,6,6],"name":"stone"},{"top":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"side":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"bottom":[8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,8,8,8,6,8,8,8,8,6,6,6,6,6,6,6,6,8,8,8,8,8,8,8,6,8,8,24,8,24,8,24,6,8,8,8,8,8,8,8,6,6,6,6,6,6,6,6,6],"name":"brick"},{"top":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"side":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"bottom":[4,4,4,4,4,4,20,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,20,4,4,4,4,4,4,4,4,4,4,4,20,20,20,20,20,20,20,20,4,4,20,4,4,4,4,4,4,4,4,4,4,4,4,20],"name":"wood"},{"top":[15,15,15,15,15,15,15,15,15,15,15,15,15,31,9,15,15,15,15,15,15,15,15,15,15,15,15,31,15,15,15,15,9,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,31,15,31,15,15,15,15,31,15,15],"side":[15,15,15,15,15,15,15,15,15,15,15,15,15,31,9,15,15,15,15,15,15,15,15,15,15,15,15,31,15,15,15,15,9,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,31,15,31,15,15,15,15,31,15,15],"bottom":[15,15,15,15