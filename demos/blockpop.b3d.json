{"version": 1, "vox": [], "sfx": ["0300002405029040300251800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "03000024450284502b4503045034435180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "0400000e2300c225180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "0800001f5501d5501b5501855218535180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "040000184401f440244451800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000"], "music": [], "name": "block pop", "code": "// Block Pop: click (or tap) a group of 2 or more touching blocks of the same color to pop it.\n// Blocks above fall into the gap. A group of n blocks scores (n - 1) * (n - 1), so big groups\n// pay off. The game ends when no group is left. Arrows / d-pad turn the camera.\n// Shows: mouse_set_mode(1), mouse_ray() + mray() to find the block under the cursor,\n// mget / mset to change the map while playing, save() / load() for the best score.\n// map 0 = the tower; map 1 = the stand under it; tiles 1-4 = the four colors, 5 = the stand\n\nconst W = 5, H = 6, D = 5          // tower size in blocks\nconst PART = [0, 8, 10, 11, 12]    // particle color for each tile\nconst LIGHT = [0, 14, 7, 26, 6]    // lighter shade of each, to light up the group under the cursor\nlet yaw = 0.6, pitch = -0.09       // the camera's view: which way it looks, and how far down\nlet score, best = 0, over, hover = [], parts = [], pops = []\n\nfunction _init() {\n  mouse_set_mode(1)                // click mode: the cursor stays free, taps count as clicks\n  bg(1)\n  map_set_pos(1, [-1, -1, -1])     // the stand sits one block below and around the tower\n  let d = load()\n  if (d) best = d.best\n  newGame()\n}\n\nfunction newGame() {\n  for (let z = 0; z < D; z++) for (let y = 0; y < H; y++) for (let x = 0; x < W; x++)\n    mset(0, x, y, z, 1 + flr(rnd(4)))\n  score = 0; over = false; parts = []; pops = []\n}\n\n// every block touching (x, y, z) with the same tile, found by flood fill\nfunction group(x, y, z) {\n  let t = mget(0, x, y, z), out = [], seen = {}, todo = [[x, y, z]]\n  if (!t) return out\n  while (todo.length) {\n    let [a, b, c] = todo.pop(), k = a + ',' + b + ',' + c\n    if (seen[k] || mget(0, a, b, c) != t) continue\n    seen[k] = true\n    out.push([a, b, c])\n    todo.push([a + 1, b, c], [a - 1, b, c], [a, b + 1, c], [a, b - 1, c], [a, b, c + 1], [a, b, c - 1])\n  }\n  return out\n}\n\n// blocks fall straight down to fill gaps, column by column\nfunction fall() {\n  for (let z = 0; z < D; z++) for (let x = 0; x < W; x++) {\n    let col = []\n    for (let y = 0; y < H; y++) if (mget(0, x, y, z)) col.push(mget(0, x, y, z))\n    for (let y = 0; y < H; y++) mset(0, x, y, z, col[y] || 0)\n  }\n}\n\nfunction movesLeft() {\n  for (let z = 0; z < D; z++) for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {\n    let t = mget(0, x, y, z)\n    if (t && (mget(0, x + 1, y, z) == t || mget(0, x, y + 1, z) == t || mget(0, x, y, z + 1) == t)) return true\n  }\n  return false\n}\n\nfunction pop(g) {\n  let t = mget(0, ...g[0]), n = g.length, pts = (n - 1) * (n - 1)\n  for (let [x, y, z] of g) {\n    mset(0, x, y, z, 0)\n    for (let i = 0; i < 3; i++)\n      parts.push({ x: x + 0.5, y: y + 0.5, z: z + 0.5, vx: rnd(0.16) - 0.08, vy: rnd(0.12), vz: rnd(0.16) - 0.08, c: PART[t], life: 40 })\n  }\n  score += pts\n  let [mx, my] = mouse_pos()\n  pops.push({ x: mx, y: my, text: '+' + pts, life: 40 })\n  sfx(n >= 6 ? 1 : 0)\n  fall()\n  if (!movesLeft()) {\n    over = true\n    if (score > best) { best = score; save({ best: best }) }\n    sfx(3)\n  }\n}\n\nfunction _update() {\n  // camera: left / right turn around the tower, up / down raise and lower it\n  if (btn(0)) yaw -= 0.005\n  if (btn(1)) yaw += 0.005\n  if (btn(2)) pitch = max(pitch - 0.003, -0.2)\n  if (btn(3)) pitch = min(pitch + 0.003, -0.01)\n\n  if (over) {\n    hover = []\n    if (btnp(4) || btnp(5) || btnp(19)) { newGame(); sfx(4) }\n  } else {\n    // the block under the cursor: a ray from the camera, then the first block it hits\n    let [t, x, y, z] = mray(0, ...mouse_ray())\n    hover = t ? group(x, y, z) : []\n    if (btnp(19)) {\n      if (hover.length >= 2) pop(hover)\n      else sfx(2)\n    }\n  }\n\n  for (let p of parts) { p.x += p.vx; p.y += p.vy; p.z += p.vz; p.vy -= 0.008; p.life-- }\n  parts = parts.filter((p) => p.life > 0)\n  for (let p of pops) { p.y -= 0.5; p.life-- }\n  pops = pops.filter((p) => p.life > 0)\n}\n\nfunction _draw() {\n  let cx = W / 2, cy = H / 2 - 0.5, cz = D / 2, r = 9.5\n  cam_orbit([cx, cy, cz], yaw, pitch, r)      // r away from the tower's middle, looking at it\n\n  outline(0)\n  map(0)\n  map(1)\n  // light up the group under the cursor: slightly bigger cubes in a lighter shade, outlined in white\n  if (hover.length >= 2) {\n    outline(7)\n    let c = LIGHT[mget(0, ...hover[0])]\n    for (let [x, y, z] of hover) cube(x + 0.5, y + 0.5, z + 0.5, 1.04, c)\n  }\n  outline()\n  for (let p of parts) cube(p.x, p.y, p.z, 0.15 * p.life / 40 + 0.05, p.c)\n\n  print('Score ' + score, 4, 4, 7, 0)\n  let b = 'Best ' + best\n  print(b, 252 - textw(b), 4, 10, 0)\n  for (let p of pops) print(p.text, p.x - 6, p.y - 14, 10, 0)\n  if (over) {\n    rectfill(40, 96, 215, 158, 1)\n    rect(40, 96, 215, 158, 7)\n    print('No more moves!', 79, 104, 10, 0)\n    let s = 'Score ' + score + (score >= best && score > 0 ? '  New best!' : '')\n    printc(s, 120, 7, 0)\n    print('click or O to play again', 44, 138, 6)\n  } else {\n    print('Click a group of 2+ to pop it', 4, 232, 6, 0)\n    print('Arrows turn the camera', 4, 244, 6, 0)\n  }\n}\n", "tiles": [null, {"top": [2, 2, 2, 2, 2, 2, 2, 2, 2, 14, 14, 14, 8, 8, 8, 2, 2, 14, 8, 8, 8, 8, 8, 2, 2, 14, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 2, 2, 2, 2, 2, 2, 2], "side": [2, 2, 2, 2, 2, 2, 2, 2, 2, 14, 14, 14, 8, 8, 8, 2, 2, 14, 8, 8, 8, 8, 8, 2, 2, 14, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 2, 2, 2, 2, 2, 2, 2], "bottom": [2, 2, 2, 2, 2, 2, 2, 2, 2, 14, 14, 14, 8, 8, 8, 2, 2, 14, 8, 8, 8, 8, 8, 2, 2, 14, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 8, 8, 8, 8, 8, 8, 2, 2, 2, 2, 2, 2, 2, 2, 2]}, {"top": [9, 9, 9, 9, 9, 9, 9, 9, 9, 7, 7, 7, 10, 10, 10, 9, 9, 7, 10, 10, 10, 10, 10, 9, 9, 7, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 9, 9, 9, 9, 9, 9, 9], "side": [9, 9, 9, 9, 9, 9, 9, 9, 9, 7, 7, 7, 10, 10, 10, 9, 9, 7, 10, 10, 10, 10, 10, 9, 9, 7, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 9, 9, 9, 9, 9, 9, 9], "bottom": [9, 9, 9, 9, 9, 9, 9, 9, 9, 7, 7, 7, 10, 10, 10, 9, 9, 7, 10, 10, 10, 10, 10, 9, 9, 7, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 10, 10, 10, 10, 10, 10, 9, 9, 9, 9, 9, 9, 9, 9, 9]}, {"top": [3, 3, 3, 3, 3, 3, 3, 3, 3, 26, 26, 26, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 3, 3, 3, 3, 3, 3, 3], "side": [3, 3, 3, 3, 3, 3, 3, 3, 3, 26, 26, 26, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 3, 3, 3, 3, 3, 3, 3], "bottom": [3, 3, 3, 3, 3, 3, 3, 3, 3, 26, 26, 26, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 1