{"version": 1, "vox": [{"name": "flag", "pivot": [1.5, 0, 4.5], "data": ""}], "sfx": ["020000146430e625180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "0500001e35318343123330c32518000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "060000180501c0501f050240601f040240622404518000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000", "040000184401f440244451800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000"], "music": [], "name": "tilt maze", "code": "// Tilt Maze: tilt the whole maze with the arrows, d-pad or stick, and roll the marble into the\n// hole with the flag. The other holes send you back to the start.\n// Shows: map_set_angle on a map you collide with. mpush() works on the rotated map, so the\n// marble's physics is just gravity plus a push-out and a bounce off the way it was pushed; mtow() finds where a\n// spot on the tilted maze is in the world (for the flag).\n// map 0 = the maze; its origin is the middle of the floor's top, so it tilts about its center.\n// tiles: 1 floor, 2 wall, 3 floor by the goal. vox 0 = the flag. sounds: 0 bump, 1 lost, 2 win, 3 start\n\nconst R = 0.28                     // marble radius\nconst START = [1.5, 1.5]           // where the marble starts (x, z) in the maze's own grid\nconst GOAL = [9, 9]                // the hole with the flag\nconst MAXTILT = 0.035              // turns, about 12.6 degrees\nlet bx, by, bz, vx, vy, vz         // marble position and velocity, in world space\nlet tp = 0, tr = 0                 // the maze's pitch and roll\nlet state = 'title', ticks = 0, best = null, flash = 0\n\nfunction _init() {\n  touch_set_mode(1)                      // on touch screens: an analog circle instead of the d-pad\n  bg(1)\n  let d = load()\n  if (d) best = d.best\n  reset()\n}\n\n// the marble back at the start, the maze level\nfunction reset() {\n  tp = tr = 0\n  map_set_angle(0, [0, 0, 0])\n  ;[bx, by, bz] = mtow(0, START[0], 1 + R + 0.05, START[1])   // the floor's top is y = 1 in the maze's grid\n  vx = vy = vz = 0\n}\n\nfunction _update() {\n  if (state != 'play') {\n    if (btnp(4) || btnp(5)) {\n      if (state != 'title') reset()\n      state = 'play'; ticks = 0; sfx(3)\n    }\n    if (state == 'title') return\n  }\n  if (state == 'play') ticks++\n  if (flash > 0) flash--\n\n  // tilt toward the stick. The camera looks along +z, so screen right is -x:\n  // pushing right raises the +x side (positive roll) and the marble rolls right;\n  // pushing up lowers the far (+z) side (negative pitch) and the marble rolls away.\n  let [sx, sy] = state == 'play' ? stick(0) : [0, 0]\n  tp += (sy * MAXTILT - tp) * 0.08\n  tr += (sx * MAXTILT - tr) * 0.08\n  map_set_angle(0, [tp, 0, tr])\n\n  // two small physics steps per update keep the marble from tunneling through walls\n  for (let step = 0; step < 2; step++) {\n    vy -= 0.005\n    bx += vx; by += vy; bz += vz\n    let [x, y, z, nx, ny, nz] = mpush(0, bx, by, bz, R)   // out of the floor and walls\n    bx = x; by = y; bz = z\n    let vn = vx * nx + vy * ny + vz * nz            // speed into the surface we were pushed off\n    if (vn < 0) {\n      if (vn < -0.04 && abs(ny) < 0.5) sfx(0)       // a hard knock against a wall\n      vx -= nx * vn * 1.3; vy -= ny * vn * 1.3; vz -= nz * vn * 1.3   // stop, with a small bounce\n    }\n    vx *= 0.995; vz *= 0.995\n  }\n\n  // below the floor? mgetw also tells us which cell of the maze a point is in\n  if (state == 'won') { if (by < -12) vx = vy = vz = 0; return }   // dropping out of sight\n  let [t, xi, yi, zi] = mgetw(0, bx, by, bz)\n  if (yi < 0) {\n    if (xi == GOAL[0] && zi == GOAL[1]) {\n      state = 'won'; sfx(2)\n      let secs = ticks / 60\n      if (best == null || secs < best) { best = secs; save({ best: best }) }\n    } else { flash = 15; sfx(1); reset() }\n  }\n}\n\nfunction fmt(s) { return flr(s * 10) / 10 + 's' }\n\nfunction _draw() {\n  cam_set_pos([0, 9, -6.2])\n  cam_set_lookat([0, -0.6, 0.7])\n  cam_set_fov(0.21)\n\n  outline(0)\n  if (flash > 0) for (let i = 0; i < 32; i++) pal(i, 8)\n  map(0)\n  pal()\n  // the flag stands in the goal hole, like a golf flag: mtow() says where that spot of the maze's\n  // grid is in the world right now, however the maze is tilted\n  vox(0, ...mtow(0, GOAL[0] + 0.5, 1, GOAL[1] + 0.5), tp, 0, tr, 1.5)\n  sphere(bx, by, bz, R, 7)\n\n  print('Time ' + fmt(ticks / 60), 4, 4, 7, 0)\n  if (best != null) { let b = 'Best ' + fmt(best); print(b, 252 - textw(b), 4, 10, 0) }\n  if (state == 'title') {\n    rectfill(20, 80, 235, 170, 1); rect(20, 80, 235, 170, 7)\n    printc('TILT MAZE', 88, 10, 0, 2)\n    printc('Tilt with the arrows or stick', 116, 7)\n    printc('Get the marble to the flag', 128, 7)\n    printc('Other holes: back to start', 140, 6)\n    if (time() % 1 < 0.6) printc('press O or X', 156, 11)\n  }\n  if (state == 'won') {\n    rectfill(40, 100, 215, 150, 1); rect(40, 100, 215, 150, 7)\n    let m = best == ticks / 60 ? 'New best time!' : 'Best ' + fmt(best)\n    printc('You made it! ' + fmt(ticks / 60), 108, 10, 0)\n    printc(m, 122, 7, 0)\n    printc('O to play again', 136, 6)\n  }\n}\n", "tiles": [null, {"top": [22, 22, 22, 22, 22, 22, 22, 22, 22, 7, 7, 7, 15, 15, 15, 22, 22, 7, 15, 15, 15, 15, 15, 22, 22, 7, 15, 15, 15, 15, 15, 22, 22, 15, 15, 15, 15, 15, 15, 22, 22, 15, 15, 15, 15, 15, 15, 22, 22, 15, 15, 15, 15, 15, 15, 22, 22, 22, 22, 22, 22, 22, 22, 22], "side": [4, 4, 20, 20, 4, 20, 4, 4, 4, 20, 4, 20, 4, 20, 20, 20, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 20, 20, 20, 20, 4, 4, 4, 4, 4, 4, 4, 4, 20, 4, 4, 20, 4, 4, 20, 4, 4, 4, 4, 4, 20, 20, 4, 20, 4, 20, 4, 4, 20, 4, 4, 4, 4, 20], "bottom": [4, 4, 4, 4, 4, 4, 20, 4, 4, 4, 4, 4, 4, 20, 20, 4, 4, 20, 20, 4, 4, 4, 4, 20, 20, 4, 4, 4, 4, 4, 4, 20, 20, 20, 4, 4, 4, 4, 20, 20, 4, 4, 20, 20, 20, 4, 4, 4, 4, 4, 4, 20, 4, 20, 4, 4, 4, 20, 4, 20, 4, 4, 4, 4]}, {"top": [5, 5, 5, 5, 5, 5, 5, 5, 5, 7, 7, 7, 6, 6, 6, 5, 5, 7, 6, 6, 6, 6, 6, 5, 5, 7, 6, 6, 6, 6, 6, 5, 5, 6, 6, 6, 6, 6, 6, 5, 5, 6, 6, 6, 6, 6, 6, 5, 5, 6, 6, 6, 6, 6, 6, 5, 5, 5, 5, 5, 5, 5, 5, 5], "side": [5, 5, 5, 5, 5, 5, 5, 5, 5, 6, 6, 6, 13, 13, 13, 5, 5, 6, 13, 13, 13, 13, 13, 5, 5, 6, 13, 13, 13, 13, 13, 5, 5, 13, 13, 13, 13, 13, 13, 5, 5, 13, 13, 13, 13, 13, 13, 5, 5, 13, 13, 13, 13, 13, 13, 5, 5, 5, 5, 5, 5, 5, 5, 5], "bottom": [5, 5, 5, 5, 5, 5, 5, 5, 5, 6, 6, 6, 13, 13, 13, 5, 5, 6, 13, 13, 13, 13, 13, 5, 5, 6, 13, 13, 13, 13, 13, 5, 5, 13, 13, 13, 13, 13, 13, 5, 5, 13, 13, 13, 13, 13, 13, 5, 5, 13, 13, 13, 13, 13, 13, 5, 5, 5, 5, 5, 5, 5, 5, 5]}, {"top": [3, 3, 3, 3, 3, 3, 3, 3, 3, 26, 26, 26, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 26, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 11, 11, 11, 11, 11, 11, 3, 3, 3, 3, 3, 3, 3, 3, 3], "side": [3, 3, 3, 19, 3, 3, 3, 3, 3, 19, 3, 3, 3, 19, 19, 3, 3, 3, 3, 3, 3, 19, 3, 3, 3, 3, 3, 19, 19, 3, 19, 3, 3, 19, 3, 3, 3, 3, 3, 3, 3, 3, 19, 3, 3, 3, 19, 3, 3, 19, 19, 3, 3, 3, 3, 3, 3, 19, 3, 3, 19, 3, 3, 3], "bottom": [19, 19, 3, 19, 3, 19, 3, 19, 19, 19, 3, 3, 19, 19, 19, 3, 19, 19, 19, 19, 3, 3, 3, 3, 3, 3, 3, 3, 3, 19, 3, 19, 3, 3, 19, 3, 19, 19, 3, 3, 3, 19, 3, 19, 19, 3, 3, 19, 3, 3, 3, 3, 19, 19, 19, 3, 3, 19, 3, 19, 19, 3, 3, 3]}], "maps": [{"name": "maze", "w": 11, "h": 2, "d": 11, "origin": [5.5, 1, 5.5], "data": ""}], "cover": "data:image/png;base64,"}
