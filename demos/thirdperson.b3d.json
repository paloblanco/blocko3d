{"version":1,"vox":[{"name":"hero","pivot":[4,0,4],"data":""},{"name":"hero step a","pivot":[4,0,4],"data":""},{"name":"hero step b","pivot":[4,0,4],"data":""},{"name":"star","pivot":[3.5,0,3.5],"data":""}],"sfx":["030000163501d351223412632518000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000","040000240602b060300503004518000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000","0500001e35318343123330c32518000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000","07000024560285602b560305602b550305623055230535180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000180001800018000","1000000c0500c0350c0500c03518050180350c0500c0350f0500f0350f0500f0351b0501b0350f0500f0350a0500a0350a0500a03516050160350a0500a0350705007035070500703513050130350a0500a035","1000001f4301f4301f4321f4151b4301b4301b4321b4151d4301d4301d4321d4151f4301f4301f4321f415224302243022432224151f4301f4301f4321f4151d4301d4301d4321d4151b4301b4301b4321b415","10000024430244302443224415224302243022432224151f4301f4301f4321f415224302243022432224151f4301f4301f4321f4151d4301d4301d4321d4151b4301b4301b4321b41518430184301843218415","1000000e663000003c6250000028645000003c625000000e663000003c6250000028645000003c625000000e663000003c6250000028645000003c625000000e663000003c6250000028645000003c62500000","100000185271b5271f52722527185271b5271f52722527185271b5271f52722527185271b5271f52722527165271b5271d52722527165271b5271d52722527165271b5271d52722527165271b5271d52722527"],"music":["104050740","204060708"],"name":"third person","code":"// Third Person: hop across floating islands and collect the 5 stars. Ride a sliding platform,\n// a turning bridge and an elevator on the way.\n// Move with the arrows, WASD, d-pad or stick (relative to the camera); X jumps.\n// Turn the camera with the mouse (click the game first; Esc frees it), the right stick, or by\n// dragging on a touch screen. If you leave it alone it swings round behind you.\n// Shows: an orbit camera kept out of walls with mray(), movement relative to the camera, and\n// riding moving maps: wtom() remembers where you stand on a platform before it moves and mtow()\n// puts you back there after, turning included.\n// maps: 0 islands, 1 sliding platform, 2 turning bridge, 3 elevator.\n// vox: 0-2 the hero (stand, step, step), 3 star. sounds: 0 jump, 1 star, 2 fall, 3 win; 4-8 song\n\nconst R = 0.4                                    // the hero's collision sphere\nconst STARS = [[13, 4.6, 0], [13, 6.6, 8.4], [13, 7.6, 14], [6.25, 7.6, 14], [-10, 11.6, 14]]\nlet px, py, pz, vx = 0, vy = 0, vz = 0, grounded = false, riding = 0\nlet facing = 0, walk = 0, camYaw = 0, camPitch = 0.07, idle = 0\nlet got, checkpoint, state = 'play', ticks = 0, best = null, flash = 0\nlet bridgeYaw = 0, wonT = 0\n\nfunction _init() {\n  bg(12)\n  mouse_set_mode(2)\n  let d = load()\n  if (d) best = d.best\n  got = STARS.map(() => false)\n  checkpoint = [0, 5, 0]\n  ;[px, py, pz] = checkpoint\n  music(0, 1500)\n}\n\n// the three moving maps, placed for time t (in updates)\nfunction placePlatforms(t) {\n  map_set_pos(1, [7.25 + sin(t / 480) * 1.6, 4, 0])           // slides between the first two islands\n  bridgeYaw = t / 1400                                         // turns slowly about its middle\n  map_set_pos(2, [6.25, 7, 14]); map_set_angle(2, [0, bridgeYaw, 0])\n  map_set_pos(3, [-5, 9 + sin(t / 360) * 2, 14])               // goes up and down between islands\n}\n\nfunction _update() {\n  // after a win, wait a second before O or X starts again (X is also jump)\n  if (state == 'won' && ++wonT > 60 && (btnp(4) || btnp(5))) { _init(); state = 'play'; ticks = 0 }\n  if (state == 'play') ticks++\n  if (flash > 0) flash--\n\n  // 1. riding: remember where we stand in the platform's own grid, move the platforms, then put\n  //    us back on the same spot. On the turning bridge we turn with it.\n  let onIt = riding ? wtom(riding, px, py, pz) : null\n  let yaw0 = bridgeYaw\n  placePlatforms(t() * 60)\n  if (onIt) {\n    ;[px, py, pz] = mtow(riding, ...onIt)\n    if (riding == 2) { facing += bridgeYaw - yaw0; camYaw += bridgeYaw - yaw0 }\n  }\n\n  // 2. the camera: mouse (once captured) or a finger, the right stick; else swing in behind\n  let [mx, my] = mouse_delta(), [rx, ry] = stick(1)\n  let look = mx * 0.0012 + rx * 0.012, tilt = my * 0.0012 + ry * 0.008\n  camYaw -= look\n  camPitch = mid(0.01, camPitch + tilt, 0.2)\n  idle = look || tilt ? 0 : idle + 1\n\n  // 3. walking, relative to where the camera looks (screen right is the camera's -x side)\n  let [sx, sy] = state == 'play' ? stick(0) : [0, 0]\n  let fx = sin(camYaw), fz = cos(camYaw)\n  let ax = (fx * -sy - fz * sx) * 0.09, az = (fz * -sy + fx * sx) * 0.09\n  vx += (ax - vx) * 0.3; vz += (az - vz) * 0.3\n  if (abs(ax) + abs(az) > 0.01) {\n    facing = atan2(az, ax); walk++\n    if (idle > 60) camYaw += ((facing - camYaw + 0.5) % 1 - 0.5) * 0.02   // swing in behind\n  } else walk = 0\n  if (btnp(5) && grounded) { vy = 0.21; sfx(0) }\n  vy -= 0.01\n  px += vx; py += vy; pz += vz\n\n  // 4. collision with the islands and all three platforms; note which one we're standing on\n  grounded = false; riding = 0\n  for (let pass = 0; pass < 3; pass++) for (let m = 0; m < 4; m++) {\n    let [t, xi, yi, zi, nx, ny, nz, d] = mgetw(m, px, py, pz, R)\n    if (!t) continue\n    px += nx * d; py += ny * d; pz += nz * d\n    if (ny > 0.5) { grounded = true; if (vy < 0) vy = 0; riding = m; if (m == 0) checkpoint = [px, py + 0.5, pz] }\n    if (ny < -0.5 && vy > 0) vy = 0\n  }\n  if (py < -8) { ;[px, py, pz] = checkpoint; vx = vy = vz = 0; flash = 15; sfx(2) }\n\n  for (let i = 0; i < STARS.length; i++) {\n    let [x, y, z] = STARS[i]\n    if (!got[i] && abs(px - x) < 0.8 && abs(py - y) < 1.1 && abs(pz - z) < 0.8) {\n      got[i] = true\n      if (got.every((g) => g) && state == 'play') {\n        state = 'won'; wonT = 0; sfx(3)\n        let s = ticks / 60\n        if (best == null || s < best) { best = s; save({ best: best }) }\n      } else sfx(1)\n    }\n  }\n}\n\nfunction fmt(s) { return flr(s * 10) / 10 + 's' }\n\nfunction _draw() {\n  // the camera sits behind and above the hero; if something's in the way, it moves in front of it\n  let tx = px, ty = py + 1, tz = pz\n  let dx = -sin(camYaw) * cos(camPitch), dy = sin(camPitch), dz = -cos(camYaw) * cos(camPitch)\n  let dist = 6.5\n  for (let m = 0; m < 4; m++) {\n    let h = mray(m, tx, ty, tz, dx, dy, dz, dist)\n    if (h[0]) dist = max(1, h[7] - 0.3)\n  }\n  cam_set_pos([tx + dx * dist, ty + dy * dist, tz + dz * dist])\n  cam_set_lookat([tx, ty, tz])\n\n  outline(0)\n  if (flash > 0) for (let i = 0; i < 32; i++) pal(i, 7)\n  for (let m = 0; m < 4; m++) map(m)\n  pal()\n  let frame = walk == 0 || !grounded ? 0 : [1, 0, 2, 0][flr(walk / 6) % 4]\n  vox(frame, px, py - R, pz, 0, facing)\n  for (let i = 0; i < STARS.length; i++) if (!got[i]) {\n    let [x, y, z] = STARS[i]\n    vox(3, x, y + sin(time() + i) * 0.12, z, 0, time() * 0.4)\n  }\n  outline()\n\n  let n = got.filter((g) => g).length\n  print('Stars ' + n + '/' + STARS.length, 4, 4, 10, 0)\n  print(fmt(ticks / 60), 252 - fmt(ticks / 60).length * 7, 4, 7, 0)\n  if (!mouse_locked() && ticks < 600) print('Click or drag to turn the camera', 128 - 32 * 3.5, 244, 7, 0)\n  if (state == 'won') {\n    rectfill(36, 96, 219, 156, 1); rect(36, 96, 219, 156, 7)\n    let m = 'All stars! ' + fmt(ticks / 60)\n    print(m, 128 - m.length * 3.5, 104, 10, 0)\n    let b = best == ticks / 60 ? 'New best time!' : 'Best ' + fmt(best)\n    print(b, 128 - b.length * 3.5, 120, 7, 0)\n    if (wonT > 60) print('O to play again', 75, 140, 6)\n  }\n}\n","tiles":[null,{"top":[3,3,3,11,11,11,11,27,3,27,11,3,3,27,27,11,27,11,11,11,3,11,11,27,11,11,11,11,11,3,11,11,11,3,11,3,11,11,27,11,11,27,11,11,27,3,11,3,11,27,3,3,27,27,11,3,11,11,11,3,11,11,3,11],"side":[11,11,11,11,11,11,11,11,4,11,11,4,11,11,4,11,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,4],"bottom":[4,4,20,20,20,20,4,20,4,20,4,4,4,20,4,4,4,20,4,4,4,4,20,20,20,4,20,4,4,4,20,20,20,4,4,20,4,4,20,20,4,20,4,20,20,4,4,4,4,20,20,20,4,4,4,4,20,4,4,4,4,20,4,4]},{"top":[4,4,4,20,4,20,20,20,20,22,20,4,4,20,4,20,4,20,20,22,4,4,4,22,22,22,4,4,22,22,4,20,4,22,20,22,4,22,20,4,22,4,4,4,20,4,20,4,4,4,22,22,4,4,4,4,20,4,4,22,20,4,4,4],"side":[4,4,20,4,22,4,22,4,22,4,22,20,4,22,4,22,4,4,4,20,4,4,4,4,20,22,4,22,4,20,4,22,20,4,22,22,20,4,4,20,20,4,20,22,4,4,22,20,20,20,22,4,4,22,4,4,4,20,20,4,4,4,22,4],"bottom":[22,4,4,22,4,4,20,22,4,4,20,22,4,20,22,22,20,4,4,4,4,4,22,20,4,4,4,22,20,4,22,4,22,4,4,22,22,22,4,4,4,4,4,20,22,22,4,4,4,4,20,4,4,22,22,4,4,22,4,4,22,4,4,4]},{"top":[5,13,5,13,5,6,5,13,5,5,5,5,5,13,13,5,13,13,5,5,5,13,5,5,5,6,5,5,13,13,5,5,6,13,5,13,5,13,6,5,13,6,13,13,5,5,5,5,13,6,5,13,5,5,5,5,13,13,13,13,6,5,5,6],"side":[13,13,6,13,13,5,13,5,5,5,5,5,13,13,5,13,5,6,13,5,5,5,5,5,6,6,13,5,5,13,13,13,5,5,5,5,5,13,5,5,6,5,5,5,13,5,6,6,13,6,5,5,5,5,5,6,6,5,6,6,5,13,5,5],"bottom":[5,13,6,5,13,5,13,13,13,13,6,5,6,13,13,5,5,5,5,5,13,5,13,5,5,5,5,13,6,6,5,5,6,13,5,5,6,5,5,5,5,6,5,13,5,13,5,5,5,5,13,5,5,5,5,13,5,13,13,6,6,13,5,13]},{"top":[4,4,4,4,4,4,4,4,4,10,10,10,9,9,9,4,4,10,9,9,9,9,9,4,4,10,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,4,4,4,4,4,4,4],"side":[4,4,4,4,4,4,4,4,4,10,10,10,9,9,9,4,4,10,9,9,9,9,9,4,4,10,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,4,4,4,4,4,4,4],"bottom":[4,4,4,4,4,4,4,4,4,10,10,10,9,9,9,4,4,10,9,9,9,9,9,4,4,10,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,9,9,9,9,9,9,4,4,4,4,4,4,4,4,4]},{"top":[2,2,2,2,2,2,2,2,2,7,7,7,14,14,14,2,2,7,14,14,14,14,14,2,2,7,14,14,14,14,14,2,2,14,14,14,14,14,14,2,2,14,14,14,14,14,14,2,2,14,14,14,14,14,14,2,2,2,2,2,2,2,2,2],"side":[2,2,2,2,2,2,2,2,2,7,